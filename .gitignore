# ==========================================
# CANOPUS + SARIntelligence Git Ignore Rules
# ==========================================

# ------------------------------------------
# 1. Satellite Imagery, Rasters & Previews
# ------------------------------------------
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.webp
*.jp2
*.bmp
*.npy
*.npz
*.pdf

# Optical pipeline data dirs
data/tiles/
data/uploads/
data/change_staging/
data/runs/
data/processed_scenes/
data/cache/
data/exports/
data/calibration/

# SAR Intelligence data dirs (runtime only)
SARIntelligence/data/processed/
SARIntelligence/data/detections/
SARIntelligence/data/previews/
SARIntelligence/data/preprocessed/
SARIntelligence/data/temporal_diffs/
SARIntelligence/data/qdrant_local/
SARIntelligence/data/templates/
SARIntelligence/data/test_fetch/
SARIntelligence/data/raw/
SARIntelligence/data/real_satellite_samples/
SARIntelligence/preprocessed/

# Keep AOI geojsons, catalog JSON & SQLite DB
!data/README.md
!data/custom_aoi.geojson
!data/berlin_tesla_aoi.geojson
!data/bhadla_solar_aoi.geojson
!data/dholera_sir_aoi.geojson
!data/jewar_airport_aoi.geojson
!SARIntelligence/data/sarintelligence.db
!data/sar_master_catalog.json

# ------------------------------------------
# 2. Model Checkpoints & Large Weights (>50MB)
# ------------------------------------------
models/retrieval/*.pt
models/retrieval/*.bin
models/retrieval/*.safetensors
models/retrieval/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.safetensors
models/**/*.onnx
models/change_head/

# SAR model weights
SARIntelligence/weights/**/*.pt
SARIntelligence/weights/**/*.pth
SARIntelligence/weights/**/*.bin
SARIntelligence/weights/**/*.safetensors
SARIntelligence/weights/**/*.onnx
SARIntelligence/weights/**/*.h5

# Generic weight extensions
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.weights
*.h5
*.pkl

# ------------------------------------------
# 3. Python Cache & Bytecode
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------
# 4. Virtual Environments & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# ------------------------------------------
# 5. IDE, OS & System Files
# ------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.system_generated/

# ------------------------------------------
# 6. Archives & Compressed Dumps
# ------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------
# 7. Presentations, Office Docs & Lock Files
# ------------------------------------------
*.ppt
*.pptx
*.doc
*.docx
~$*

# ------------------------------------------
# 8. Scratch & Temporary Scripts (all levels)
# ------------------------------------------
scratch/
scratch_test/
backend/scratch/
SARIntelligence/data/generators/scratch/
compare_*.py
generate_*.py
scratch_*.py
show_cloudy_tiles.py
verify_*.py
clear_system_data.py
create_showcase.py
run_master_ingestion.py
run_tactical_query.py

# ------------------------------------------
# 9. External References & Unused Dirs
# ------------------------------------------
SIH2026/
datasets/defense_strategic_bases.geojson
data/mstar_dataset/
data/sar_annotated/
data/sar_qdrant/
data/sar_temporal_diffs/
data/test_qdrant/
